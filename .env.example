# ── Database ──────────────────────────────────────────────────────────────
# Leave empty to use the embedded PGlite database in PGLITE_DATA_DIR.
# Set to a postgres:// URL for real PostgreSQL (production).
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ── Auth (better-auth) ────────────────────────────────────────────────────
# ≥ 32 characters, REQUIRED in production: `openssl rand -base64 32`. Dev/test fall back to an insecure default.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin (https://app.example.com). Leave empty in dev – better-auth infers it from the request,
# which works on any port (e.g. parallel dev servers on 3100+n).
BETTER_AUTH_URL=
# Extra origins allowed to call the auth API, comma-separated. localhost:* is always allowed outside production.
BETTER_AUTH_TRUSTED_ORIGINS=

# ── Food data providers ───────────────────────────────────────────────────
# USDA FoodData Central – free key at https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for development but is heavily rate-limited.
USDA_API_KEY=DEMO_KEY
# Open Food Facts asks for an identifying User-Agent (app name + contact).
OFF_USER_AGENT=NutritionApp/0.1 (dev@example.com)
# Set to "false" to disable all external provider calls (offline mode).
FOOD_EXTERNAL_PROVIDERS_ENABLED=true

# ── Runtime ───────────────────────────────────────────────────────────────
# debug | info | warn | error | silent (default: debug in dev, info in prod, warn in tests)
LOG_LEVEL=
# Max connections of the node-postgres pool (only with DATABASE_URL).
DB_POOL_MAX=10
