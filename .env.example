# ── Database ──────────────────────────────────────────────────────────────
# Leave empty to use the embedded PGlite database in PGLITE_DATA_DIR.
# Set to a postgres:// URL for real PostgreSQL (production).
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ── Auth (better-auth) ────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ── Food data providers ───────────────────────────────────────────────────
# USDA FoodData Central – free key at https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for development but is heavily rate-limited.
USDA_API_KEY=DEMO_KEY
# Open Food Facts asks for an identifying User-Agent (app name + contact).
OFF_USER_AGENT=NutritionApp/0.1 (dev@example.com)
# Set to "false" to disable all external provider calls (offline mode).
FOOD_EXTERNAL_PROVIDERS_ENABLED=true
